<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Lab_1_PashinD.V._BPI_23_02">
    
    <Style TargetType="local:MainWindow">
        <Setter Property="Background" Value="#FF071827" />
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="BorderBrush" Value="#FF47838E"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Background" Value="#FFB6DDFF" />
        <Setter Property="Foreground" Value="#FF47838E" />

        <Style.Resources>
            <Style TargetType="{x:Type Border}">
                <Setter Property="CornerRadius" Value="5" />
            </Style>
        </Style.Resources>
        
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#FFD6ECFF" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="Background" Value="#FFD6ECFF" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="Bahnschrift Light" />
        <Setter Property="Foreground" Value="#FF7ABECD" />
    </Style>
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Bahnschrift Light" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="Background" Value="#FF5EC3FF" />
        <Setter Property="Foreground" Value="#FF0D3137"/>
        <Setter Property="FontFamily" Value="Segoe UI Black"/>
        <Setter Property="FontSize" Value="10" />
        <Setter Property="BorderBrush" Value="#FF47838E"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Style.Resources>
            <Style TargetType="{x:Type Border}">
                <Setter Property="CornerRadius" Value="5" />
            </Style>
        </Style.Resources>
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True"/>
                    <Condition Property="IsEnabled" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="#FF0E5153"/>
                <Setter Property="Foreground" Value="DarkBlue"/>
            </MultiTrigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsPressed" Value="True"/>
                    <Condition Property="IsEnabled" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="DarkBlue"/>
                <Setter Property="Foreground" Value="White"/>
            </MultiTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>